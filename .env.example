# Домен стенда: A-запись должна указывать на IP сервера ДО запуска (иначе Caddy не выпустит сертификат)
WS_DOMAIN=aurum.example.ru

# --- Модели (только из списка ТЗ). Формат провайдер:модель. Сверьте идентификаторы с документацией провайдера.
MODEL_EXPAND=gigachat:GigaChat-2-Max
MODEL_EXTRACT=gigachat:GigaChat-2
MODEL_CANONICAL=gigachat:GigaChat-2
MODEL_REPORT=gigachat:GigaChat-2-Max
MODEL_JUDGE=gigachat:GigaChat-2-Pro

# GigaChat: ключ авторизации (Base64 client_id:client_secret) из личного кабинета
GIGACHAT_AUTH_KEY=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
# Сертификат НУЦ Минцифры: путь к файлу или GIGACHAT_VERIFY_SSL=false (только для отладки)
GIGACHAT_CA_BUNDLE=/srv/certs/russian_trusted_root_ca.pem
GIGACHAT_VERIFY_SSL=true
# Повторы при 429/5xx/таймаутах и потолок одновременных запросов к модели (0 — без потолка).
# Если в журнале /api/jobs/{id}/llm много 429 — поставьте LLM_MAX_CONCURRENCY=1 или 2.
LLM_RETRIES=4
LLM_MAX_CONCURRENCY=0
LLM_TIMEOUT_SEC=180

# YandexGPT (если используете): yandex:yandexgpt-lite/latest, yandex:yandexgpt/latest
YANDEX_API_KEY=
YANDEX_FOLDER_ID=

# gpt-4.1 / gpt-5.6-luna (openai:gpt-4.1) и Qwen (qwen:<id модели>) через OpenAI-совместимый API
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
QWEN_API_KEY=
QWEN_BASE_URL=

# --- Источники
GITHUB_TOKEN=
CONTACT_EMAIL=team@example.com
SOURCES_MODE=live

# --- Конвейер
TOP_N=15
MAX_CANDIDATES=60
TIME_BUDGET_SEC=1020
CACHE_TTL_HOURS=72

# --- Обучение: одна фиксированная дата на весь прогон (кэш работает после полуночи, признаки воспроизводимы)
AS_OF_DATE=2026-09-28
